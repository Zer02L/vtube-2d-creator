{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "creator-2d-avatar",
  "version": "0.1.0",
  "identifier": "com.vtuber2d.creator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "2D VTuber Studio",
        "width": 1040,
        "height": 720,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "2D Avatar Overlay",
        "width": 600,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
